# Supabase
# Migration 030 removes live PUBLIC/anon/authenticated database access. The
# backend requires the service key and never falls back to SUPABASE_KEY.
# Never expose the service key to the browser.
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Direct/session PostgreSQL URL used by migrate, backup and restore.
# Do not use the transaction pooler for scripts that need sessions or pg_dump.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Dedicated replay reader URL (server-only). The login role must be a member of
# sabha_replay_reader; see scripts/replay_roles.py. Never use DATABASE_URL or the
# service key here. Empty until strict replay is configured.
REPLAY_DATABASE_URL=

# Default LLM Provider: "ollama" (local), "openrouter" (cloud), or "gemini" (Google)
DEFAULT_LLM_PROVIDER=gemini

# Ollama (local) - No API key needed!
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
# Comma-separated trusted origins for user-supplied Ollama URLs (SSRF guard).
OLLAMA_ALLOWED_ORIGINS=

# OpenRouter (cloud)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# Gemini (Google) - Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Qdrant vector projection (cloud or local)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding provider: "gemini", "openai", "cohere" or "ollama"
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OPENAI_API_KEY=
COHERE_API_KEY=

# Original document byte store (Supabase Storage bucket, private)
KNOWLEDGE_BUCKET=knowledge-sources

# App
APP_ENV=development
RUNTIME_MODE=local
CORS_ORIGINS=["http://localhost:3000"]

# Durable turn queue (spec 07)
TURN_MAX_QUEUED_PER_MEETING=10
TURN_GLOBAL_CONCURRENCY=1
TURN_LEASE_SECONDS=60
TURN_POLL_SECONDS=0.5
TURN_RUNNER_ENABLED=true
TURN_EXECUTION_TIMEOUT_SECONDS=300

# Coordinated closing (spec 08)
CLOSING_ATTEMPT_LEASE_SECONDS=120
CLOSING_DRAIN_TIMEOUT_SECONDS=300
